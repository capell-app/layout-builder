    "marketplace": {
        "summary": "Editors build and rearrange pages from widgets without a developer, and replace a widget across many layouts after a preview.",
        "description": "Build pages from widgets you place, move and reuse. Change text and images in the content editor, or rearrange widgets in the layout view. Replace or move a widget across many layouts after a preview, and large runs finish in background jobs, which your developer or host keeps running.",
        "problem": "I have to ask a developer every time a page needs a section moved, swapped or added.",
        "outcome": "Editors compose pages from reusable widgets and swap a widget across layouts after a preview.",
        "faq": [
            {
                "question": "Can I undo a change I make in the layout view?",
                "answer": "Moving and resizing a widget can be undone until you press Save Layout. Adding or removing a widget cannot be undone."
            },
            {
                "question": "What happens if two editors change the same layout?",
                "answer": "If someone else saved the layout after you opened it, your save is rejected and the builder reloads their version. You then make your change again on the refreshed layout."
            },
            {
                "question": "Can I swap one widget for another across many layouts at once?",
                "answer": "Yes, with Move or replace widgets on the Layouts list. You see a preview first and nothing changes until you approve it. Runs that reach 50 layouts or 250 pages wait for background jobs."
            }
        ],
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Marketplace card titled Layout Builder with a home page and a Layouts list beside the words Area, Widget and HTML.",
                "caption": "The Marketplace card for Layout Builder, the page builder that places widgets on pages."
            },
            {
                "path": "docs/screenshots/widgets-admin-index.png",
                "alt": "Widgets list with name, type, usage and status, showing Announcement Bar unused and Article Archives used in six layouts.",
                "caption": "See which widgets are in use and which are unused before you change one."
            },
            {
                "path": "docs/screenshots/sections-admin-index.png",
                "alt": "Layouts list as cards headed Archives, Article and Author Results, with page counts and a Move or replace widgets button.",
                "caption": "Browse layouts, see how many pages use each one and start a widget swap."
            },
            {
                "path": "docs/screenshots/create-edit-widget-form.png",
                "alt": "Announcement Bar widget form with a title, rich text content, a Publish panel and tabs for Details and Placement.",
                "caption": "Edit a widget's content and publishing, with separate tabs for placement and appearance."
            }
        ],
        "categories": ["admin", "foundation", "frontend"]
    },
